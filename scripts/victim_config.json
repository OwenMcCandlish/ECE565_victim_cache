{
    "gem5_bin": "build/ECE565-X86/gem5.opt",
    "spec_config_py": "configs/spec/spec_victim_cache_config.py",
    "out_root": "out",

    "common_args": [
      "--cpu-type=X86MinorCPU",
      "--enable-fast-forward",
      "--caches"
    ],

    "configs": [
      {
        "name": "minor_no_victim",
        "args": ["--disable-victim-cache"]
      },
      {
        "name": "minor_victim_alloc",
        "args": ["--enable-victim-cache"]
      },
      {
        "name": "minor_victim_no_alloc_64",
        "args": ["--enable-victim-cache", "--no-allocate"]
      },
      {
        "name": "minor_victim_no_alloc_16",
        "args": ["--enable-victim-cache", "--no-allocate", "--vc-entries", "16"]
      },
      {
        "name": "minor_victim_no_alloc_256",
        "args": ["--enable-victim-cache", "--no-allocate", "--vc-entries", "256"]
      }
    ]
  }

